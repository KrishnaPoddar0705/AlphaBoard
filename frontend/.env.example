# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk authentication. The PUBLISHABLE key (pk_...), never the secret key (sk_...) --
# every VITE_* variable is inlined into the public JS bundle. vite.config.ts refuses to
# build if it finds a secret-shaped value here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# --- Product analytics (PostHog) ---------------------------------------------
#
# The project token (phc_...) is a write-only public key, safe in the bundle. Build-time,
# like every VITE_* variable: on Cloudflare Pages it must be a build environment variable.
# Leave unset to disable analytics entirely. Nothing is sent from `npm run dev` unless
# VITE_POSTHOG_DEV=true.
# VITE_POSTHOG_KEY=phc_your-project-token
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_DEV=true

# --- Backend API -------------------------------------------------------------
#
# Leave BOTH of these unset for normal local development. `npm run dev` then serves the
# API on the same origin and proxies it to the deployed backend, so stock search and
# every other market lookup work with nothing else running.
#
# VITE_API_URL: forces an absolute API base URL, bypassing the dev proxy. Baked in at
# build time, so on Cloudflare Pages it must be a *build* environment variable. Only set
# it locally if you specifically want to bypass the proxy -- and note that a
# cross-origin dev server only works on a port the backend's CORS allowlist names
# (backend/app/main.py: 5173-5175), which Vite will not always give you.
# VITE_API_URL=https://alphaboard-backend.fly.dev
#
# DEV_API_PROXY_TARGET: where the dev proxy forwards to. Deliberately NOT a VITE_
# variable -- it is read by vite.config.ts in Node and never reaches the browser bundle.
# Set this when you are running the FastAPI backend locally:
#   cd backend && uvicorn app.main:app --reload --port 8000
# DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Edge functions (local development) --------------------------------------
#
# Leave unset to use the project's DEPLOYED edge functions. That is the normal case.
#
# Set it to run one locally against the real database, with NO deploy. Worth doing when
# a deployed function has drifted from the source in this repo, or to test a change to
# one before shipping it.
#
# Serve sync-clerk-user locally (Docker; no Deno install needed):
#
#   cd supabase/functions/sync-clerk-user
#   docker run --rm -p 8000:8000 -v "$PWD":/w -w /w \
#     -e SUPABASE_URL="https://<project-ref>.supabase.co" \
#     -e SUPABASE_SERVICE_ROLE_KEY="<service_role key>" \
#     --entrypoint deno denoland/deno:alpine-2.1.4 \
#     run --allow-net --allow-env --no-lock index.ts
#
# The key must be the SERVICE ROLE one (Supabase -> Project Settings -> API ->
# service_role). An anon key fails every admin call with "403 not_admin", which surfaces
# in the app as a flat "permission denied" that looks like a broken migration.
#
# Only the Clerk -> Supabase sign-in (lib/clerkSupabaseSync.ts) uses this override. Every
# other edge function (teams, organizations, weights...) still goes to the deployed
# project, because the container above serves sync-clerk-user and nothing else.
#
# Then restart `npm run dev`.
#
# VITE_EDGE_FUNCTIONS_URL=http://127.0.0.1:8000
