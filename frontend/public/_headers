# Cloudflare Pages response headers.
#
# Replaces the previous contents, which set X-Rewrite-For and X-Rewrite-To.
# Those are not real headers — no CDN, proxy or browser interprets them — so
# they added two bytes of noise to every response and achieved nothing. SPA
# routing is handled in _redirects instead.

# Vite fingerprints everything under /assets with a content hash
# (index-45PzKMw7.js), so a given URL can never change contents. Cache it
# permanently and let the hash handle invalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point is NOT hashed and must be revalidated every load, otherwise
# users keep booting an old bundle that references deleted asset hashes.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Never let a service worker script be cached — a stale one cannot be replaced.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
