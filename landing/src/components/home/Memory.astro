---
/** How-it-works, "Accordion of tinted panels": the firm's reports, four ways in. */
import DeskMemory from '../ui/DeskMemory.astro';
---
<section class="mem chapter chapter--ink" id="brain" data-section="memory" aria-labelledby="mem-title">
  <div class="intro" data-reveal>
    <h2 id="mem-title" class="type-wide">Ask what the firm already knows.</h2>
    <p class="say">Institutional Memory holds the transcripts, broker notes and annual reports your firm uploads. Ask the Brain a question and it reads across all of them, then shows you the sources behind the answer.</p>
    <div class="gem" data-diamond="metal" aria-hidden="true"></div>
  </div>
  <DeskMemory />
</section>

<style>
  .mem { padding: 96px var(--margin); min-height: 100svh; display: grid; align-content: center; gap: 56px; }
  .intro { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gap); align-items: end; }
  h2 { grid-column: 1 / 6; font-size: var(--s-4); }
  .say { grid-column: 6 / 10; font-size: var(--s-1); }
  .gem { grid-column: 10 / 13; width: min(100%, 260px); justify-self: end; margin-block: -32px; }
  @media (max-width: 960px) {
    .mem { padding-block: 72px; gap: 32px; }
    .intro { display: grid; grid-template-columns: 1fr; gap: 16px; }
    h2, .say { grid-column: 1; }
    .gem { grid-column: 1; grid-row: 1; width: 150px; justify-self: start; margin: 0; }
  }
</style>
