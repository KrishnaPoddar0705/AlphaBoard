---
/** "Wide photo, colour tile, facts": the street, the old map, and how India's desks work. */
import Photo from '../ui/Photo.astro';
const facts = [
  ['Tickers', 'NSE and BSE'],
  ['Fiscal year', 'April to March'],
  ['Holdings', 'Promoter, FII, DII'],
  ['Figures', 'Rupee crore'],
];
const firms = [
  ['/solutions/pms', 'PMS'],
  ['/solutions/aif', 'AIF'],
  ['/solutions/family-offices', 'Family offices'],
  ['/solutions/venture-capital', 'Venture capital'],
];
---
<section class="ind chapter" data-section="india" aria-labelledby="ind-title">
  <div class="head" data-reveal>
    <h2 id="ind-title">Built for how India invests.</h2>
    <p>Global research tools treat India as one more market. AlphaBoard starts here, with Indian tickers, Indian quarters and the sources Indian analysts actually read.</p>
  </div>
  <div class="tiles">
    <figure class="wide">
      <video data-ind-video muted loop playsinline preload="none" poster="/media/mumbai-street-poster.jpg" width="1280" height="720" aria-label="A Mumbai street with towers behind it">
        <source src="/media/mumbai-street.mp4" type="video/mp4" />
      </video>
      <figcaption>
        For the desks of Mumbai and beyond:{' '}
        {firms.map(([href, label], i) => <><a href={href}>{label}</a>{i < firms.length - 1 ? ', ' : '.'}</>)}
      </figcaption>
    </figure>
    <div class="side">
      <figure class="map"><Photo name="bombay-1758-map" alt="French plan of Bombay Fort, 1758" sizes="(max-width: 760px) 100vw, 30vw" /></figure>
      <dl>
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </div>
  <a class="link" href="/india" data-track-cta="home-connectors">What’s built for Indian markets</a>
</section>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.2 });
    document.querySelectorAll<HTMLVideoElement>('[data-ind-video]').forEach((v) => io.observe(v));
  }
</script>

<style>
  .ind { padding: 96px var(--margin); display: grid; gap: 40px; justify-items: start; }
  .head { width: 100%; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gap); align-items: end; }
  h2 { grid-column: 1 / 8; }
  h2 { font-size: var(--s-4); }
  .head p { grid-column: 8 / 13; font-size: 17px; }
  .tiles { width: 100%; display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
  .wide { position: relative; grid-column: 1 / 9; margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--ink); }
  .wide video { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  figcaption { position: absolute; top: 0; right: 0; width: 320px; padding: 20px; background: var(--ground); font-size: 16px; }
  .side { grid-column: 9 / 13; display: grid; gap: 20px; align-content: start; }
  .map { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px var(--gap); }
  dt { font-size: var(--s-0); color: var(--ink-soft); }
  dd { margin: 0; font-size: 17px; }
  @media (max-width: 960px) {
    .head { display: grid; grid-template-columns: 1fr; gap: 16px; }
    h2, .head p { grid-column: 1; }
    .wide, .side { grid-column: 1 / -1; }
    .wide { aspect-ratio: auto; overflow: visible; background: none; }
    .wide video { aspect-ratio: 4 / 3; height: auto; }
    figcaption { position: static; width: auto; padding: 14px 0 0; }
  }
  @media (max-width: 760px) { .ind { padding-block: 72px; } }
</style>
