---
/**
 * The Thinking Board in two halves: what the analyst hands it (data pulls and their own
 * view) and the note it becomes. Publishing sends that view to the log, which is what the
 * Matrix and the Brain read. Without script every block shows, so the note is complete.
 */
import { BOARD_DATA as D, CONNECTORS, NOTE } from '../../data/desk';

interface Props { part: 'in' | 'out' }
const { part } = Astro.props;

const c = Object.fromEntries(CONNECTORS.map((k) => [k.id, k]));
const chip = (id: string) => `${c[id].source} · ${c[id].fetched}`;
const START = new Set(['concall', 'results']);
const { years, operating, free } = D.cashflow;
const max = Math.max(...operating);
const tables = [
  ['results', 'Quarterly results', D.results],
  ['income', 'Income statement', D.income],
  ['balance', 'Balance sheet', D.balance],
  ['ratios', 'Ratios & history', D.ratios],
  ['holding', 'Shareholding', D.holding],
] as const;
---
{part === 'in' && <div class="tbx-in">
  <form class="tbx-pull" onsubmit="return false">
    <fieldset>
      <legend>Pull data for {NOTE.company}</legend>
      <div class="tbx-chips">
        {CONNECTORS.map((k) => (
          <button type="button" data-pull={k.id} aria-pressed={START.has(k.id) ? 'true' : 'false'}>{k.label}</button>
        ))}
      </div>
    </fieldset>
    <label class="tbx-view">Your view
      <textarea data-view rows="3">{NOTE.view}</textarea>
    </label>
  </form>
</div>}

{part === 'out' && <div class="tbx-out ui-card" data-ui>
  <div class="tbx-top">
    <span class="tbx-tag">{NOTE.ticker}</span>
    <span class="tbx-words"><span data-words>128</span> words · Saved</span>
    <button type="button" class="tbx-pub" data-publish>Publish to log</button>
  </div>
  <p class="tbx-done" data-done hidden>Published to the log. <a href="#matrix">See it in the Matrix</a>.</p>
  <div class="tbx-note" data-note data-lenis-prevent tabindex="0" aria-label="Research note">
    <h3>{NOTE.company}: {NOTE.title} concall</h3>
    <p class="tbx-v" data-view-out>{NOTE.view}</p>

    <section class:list={['tbx-b', { 'is-on': START.has('concall') }]} data-block="concall">
      <header><b>Concall · {NOTE.title}</b><span>{chip('concall')}</span></header>
      <h4>Positives</h4><ul>{D.concall.positives.map((t) => <li>{t}</li>)}</ul>
      <h4>Negatives</h4><ul>{D.concall.negatives.map((t) => <li>{t}</li>)}</ul>
    </section>

    {tables.map(([id, label, t]) => (
      <section class:list={['tbx-b', { 'is-on': START.has(id) }]} data-block={id}>
        <header><b>{label}</b><span>{chip(id)}</span></header>
        <table>
          <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{t.rows.map((r) => <tr>{r.map((v, i) => (i === 0 ? <th scope="row">{v}</th> : <td>{v}</td>))}</tr>)}</tbody>
        </table>
      </section>
    ))}

    <section class="tbx-b" data-block="cashflow">
      <header><b>Cash flow, ₹ crore</b><span>{chip('cashflow')}</span></header>
      <div class="tbx-chart" role="img" aria-label={`Operating cash flow rose from ${operating[0]} to ${operating[3]} crore and free cash flow from ${free[0]} to ${free[3]} crore, ${years[0]} to ${years[3]}`}>
        {years.map((y, i) => (
          <div class="tbx-yr">
            <div class="tbx-bars">
              <i style={`height:${(operating[i] / max) * 100}%`}><b>{operating[i]}</b></i>
              <i class="f" style={`height:${(free[i] / max) * 100}%`}><b>{free[i]}</b></i>
            </div>
            <span>{y}</span>
          </div>
        ))}
      </div>
      <p class="tbx-key"><i></i>Operating cash flow <i class="f"></i>Free cash flow</p>
    </section>

    <section class="tbx-b" data-block="events">
      <header><b>Corporate events</b><span>{chip('events')}</span></header>
      <ul>{D.events.map((t) => <li>{t}</li>)}</ul>
    </section>

    <section class="tbx-b" data-block="news">
      <header><b>News</b><span>{chip('news')}</span></header>
      <ul>{D.news.map((t) => <li>{t}</li>)}</ul>
    </section>
  </div>
</div>}

<script>
  import { mountBoard } from '../../lib/desk';
  document.querySelectorAll<HTMLElement>('[data-board]').forEach(mountBoard);
</script>

<style is:global>
  .tbx-pull { display: grid; gap: 28px; }
  .tbx-pull fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .tbx-pull legend { padding: 0; margin-bottom: 14px; font-size: var(--s-1); }
  .tbx-chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .tbx-chips button {
    min-height: 48px; padding: 6px 10px; border: 0; cursor: pointer; text-align: left;
    font: inherit; font-size: 14px; line-height: 1.2; color: var(--accent-ink); background: rgb(0 0 0 / 0.2);
    transition: background-color 180ms var(--ease), color 180ms var(--ease), transform 180ms var(--ease);
  }
  .tbx-chips button:hover { background: rgb(0 0 0 / 0.34); }
  .tbx-chips button:active { transform: scale(0.98); }
  .tbx-chips button[aria-pressed='true'] { background: var(--ground); color: var(--ink); }
  .tbx-chips button:focus-visible, .tbx-view textarea:focus-visible { outline-color: var(--accent-ink); }
  .tbx-view { display: grid; gap: 14px; font-size: var(--s-1); }
  .tbx-view textarea {
    width: 100%; padding: 14px 16px; resize: vertical; border: 0; color: var(--ink); background: var(--ground);
    font-family: var(--display); font-size: 21px; line-height: 1.3;
  }

  .tbx-out { font-size: 15px; line-height: 1.5; overflow: hidden; }
  .tbx-top { display: flex; align-items: center; gap: 12px; padding: 10px 12px; flex-wrap: wrap; }
  .tbx-tag { padding: 3px 8px; border-radius: 5px; background: var(--ink); color: var(--paper-on-ink); font-size: 12px; }
  .tbx-words { margin-left: auto; font-size: 13px; color: var(--ink-soft); }
  .tbx-pub {
    min-height: 40px; padding: 0 14px; border: 0; border-radius: 8px; cursor: pointer;
    background: var(--ink); color: var(--paper-on-ink); font: inherit; font-size: 14px; font-weight: 500;
    transition: background-color 180ms var(--ease), transform 180ms var(--ease);
  }
  .tbx-pub:hover { background: var(--accent); }
  .tbx-pub:active { transform: scale(0.98); }
  .tbx-done { padding: 8px 14px; background: var(--ground-2); font-size: 14px; }
  .tbx-note { height: min(60svh, 560px); overflow-y: auto; padding: 18px 22px 26px; position: relative; font-family: var(--display); }
  .tbx-note h3 { font-size: 24px; letter-spacing: -0.015em; line-height: 1.15; }
  .tbx-v { margin: 10px 0 18px; padding: 2px 6px; background: #f4e3a6; box-decoration-break: clone; font-size: 17px; }
  .tbx-b { margin-top: 14px; padding: 12px 14px; background: var(--ground); border: 1px solid var(--ground-3); border-radius: 8px; font-family: var(--text); font-size: 14px; }
  .js .tbx-b:not(.is-on) { display: none; }
  .tbx-b.is-on { animation: tbx-in 420ms var(--ease-out); }
  @keyframes tbx-in { from { opacity: 0; transform: translateY(8px); } }
  .tbx-b header { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .tbx-b header b { font-weight: 500; }
  .tbx-b header span { font-size: 12px; color: var(--ink-soft); white-space: nowrap; }
  .tbx-b h4 { margin: 10px 0 4px; font-family: var(--text); font-size: 14px; font-weight: 500; letter-spacing: 0; }
  .tbx-b ul { display: grid; gap: 4px; padding-left: 16px; list-style: disc; }
  .tbx-b table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .tbx-b th, .tbx-b td { padding: 4px 0; text-align: right; font-weight: 400; }
  .tbx-b tr > :first-child { text-align: left; }
  .tbx-b thead th { color: var(--ink-soft); font-size: 13px; }
  .tbx-chart { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; height: 148px; }
  .tbx-yr { display: grid; grid-template-rows: 1fr auto; gap: 4px; text-align: center; font-size: 12px; color: var(--ink-soft); }
  .tbx-bars { display: flex; align-items: flex-end; justify-content: center; gap: 4px; padding-top: 16px; }
  .tbx-bars i { position: relative; width: 26px; background: var(--ink); }
  .tbx-bars i.f { background: var(--pos); }
  .tbx-bars b { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); font-size: 11px; font-weight: 400; color: var(--ink-soft); }
  .tbx-key { margin-top: 6px; font-size: 12px; color: var(--ink-soft); }
  .tbx-key i { display: inline-block; width: 9px; height: 9px; margin: 0 4px 0 0; background: var(--ink); }
  .tbx-key i.f { margin-left: 12px; background: var(--pos); }
  @media (prefers-reduced-motion: reduce) { .tbx-b.is-on { animation: none; } }
  @media (max-width: 760px) {
    .tbx-chips { grid-template-columns: repeat(2, 1fr); }
    .tbx-note { height: 460px; padding: 14px 14px 20px; }
    .tbx-words { display: none; }
    .tbx-pub { margin-left: auto; }
    .tbx-b header { flex-direction: column; gap: 0; }
  }
</style>
