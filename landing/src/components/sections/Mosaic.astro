---
/**
 * A gutterless mosaic of Dalal Street and the old Fort: photographs, one muted film
 * loop and flat colour tiles butted together, the way a two-colour annual report
 * would run a picture page. `start` rotates which pictures lead, so neighbouring
 * pages do not repeat the same opening.
 */
import Photo from '../ui/Photo.astro';
import type { ImageName } from '../../lib/images';

interface Props { start?: number; caption?: string }
const { start = 0, caption } = Astro.props;

const PICS: { name: ImageName; alt: string }[] = [
  { name: 'bse-building', alt: 'The Bombay Stock Exchange building, Dalal Street' },
  { name: 'dalal-street-sign', alt: 'Dalal Street road sign, PIN 400001' },
  { name: 'bombay-1758-map', alt: 'French plan of Bombay Fort, 1758' },
  { name: 'bse-tower-2006', alt: 'The BSE tower seen from the street' },
  { name: 'bombay-fort-1936', alt: 'Bombay Fort seen from the sea' },
];
const pics = [...PICS.slice(start % PICS.length), ...PICS.slice(0, start % PICS.length)].slice(0, 3);
---
<section class="mosaic" data-section="mosaic" aria-label={caption ?? 'Dalal Street and the old Bombay Fort'}>
  <div class="grid" data-reveal>
    <figure class="c a"><Photo name={pics[0].name} alt={pics[0].alt} sizes="(max-width: 760px) 100vw, 33vw" /></figure>
    <div class="c tile ink" aria-hidden="true"></div>
    <figure class="c b">
      <video class="photo" data-mosaic-video muted loop playsinline preload="none" poster="/media/mumbai-street-poster.jpg" width="1280" height="720" aria-label="A Mumbai street with towers behind it">
        <source src="/media/mumbai-street.mp4" type="video/mp4" />
      </video>
    </figure>
    <figure class="c d"><Photo name={pics[1].name} alt={pics[1].alt} sizes="(max-width: 760px) 50vw, 33vw" /></figure>
    <div class="c tile green" aria-hidden="true"></div>
    <figure class="c e"><Photo name={pics[2].name} alt={pics[2].alt} sizes="(max-width: 760px) 50vw, 33vw" /></figure>
  </div>
  {caption && <p class="cap wrap">{caption}</p>}
</section>

<script>
  const vids = document.querySelectorAll<HTMLVideoElement>('[data-mosaic-video]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .mosaic { padding-bottom: var(--section); }
  .grid {
    display: grid; grid-template-columns: 3fr 1fr 4fr 4fr; grid-template-rows: 26vw 18vw;
    max-height: 820px; padding-inline: var(--margin);
  }
  .c { margin: 0; overflow: hidden; min-height: 0; }
  .a { grid-column: 1 / 3; grid-row: 1; }
  .ink { grid-column: 1; grid-row: 2; background: var(--ink); }
  .b { grid-column: 3; grid-row: 1 / 3; }
  .d { grid-column: 4; grid-row: 1; }
  .green { grid-column: 2; grid-row: 2; background: var(--accent); }
  .e { grid-column: 4; grid-row: 2; }
  .cap { margin-top: 14px; font-size: 16px; color: var(--ink-soft); }
  .c .photo { transition: transform 1.2s var(--ease); }
  .c:hover .photo { transform: scale(1.03); }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr 1fr; grid-template-rows: 56vw 40vw 40vw; }
    .a { grid-column: 1 / 3; grid-row: 1; }
    .b { grid-column: 1; grid-row: 2 / 4; }
    .d { grid-column: 2; grid-row: 2; }
    .e { grid-column: 2; grid-row: 3; }
    .ink, .green { display: none; }
  }
</style>
