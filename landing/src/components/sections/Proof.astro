---
/** A whole page of colour: one statement on the axis, the product beside it. */
import type { Visual as V } from '../../data/pages';
import Visual from '../ui/Visual.astro';
interface Props { title: string; text: string; visual?: V }
const { title, text, visual } = Astro.props;
---
<section class="proof" data-section="proof" aria-labelledby="proof-title">
  <div class="inner wrap">
    <div class="vis">{visual && <Visual kind={visual} />}</div>
    <div class="copy" data-reveal>
      <h2 id="proof-title">{title}</h2>
      <p>{text}</p>
    </div>
  </div>
</section>
<style>
  .proof { background: var(--accent); color: var(--accent-ink); padding-block: var(--section); }
  .inner { display: grid; grid-template-columns: var(--axis) 1fr; column-gap: var(--gap); align-items: center; }
  .vis { padding-right: 48px; }
  .vis > :global(*) { width: 100%; }
  h2 { font-size: var(--s-4); max-width: 11em; margin-bottom: 28px; }
  p { font-size: var(--s-3); line-height: 1.3; max-width: 26em; font-family: var(--display); }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; gap: 40px; }
    .vis { padding: 0; order: 2; }
  }
</style>
