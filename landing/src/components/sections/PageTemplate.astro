---
/**
 * One template for the product and solution pages: the street beside the page's promise,
 * the reader's own pains, their process with AlphaBoard in it, a product fragment with
 * what changes, then questions and the close.
 */
import Base from '../../layouts/Base.astro';
import Visual from '../ui/Visual.astro';
import Photo from '../ui/Photo.astro';
import type { ImageName } from '../../lib/images';
import Faq from '../home/Faq.astro';
import Close from '../home/Close.astro';
import { PRODUCTS, SOLUTIONS, type LandingPage } from '../../data/pages';
import { breadcrumbs, faqPage, softwareApplication } from '../../lib/schema';

interface Props { page: LandingPage; section: 'product' | 'solutions' }
const { page, section } = Astro.props;
const isProduct = section === 'product';
const path = `/${section}/${page.slug}`;
const crumb = isProduct ? { name: 'Product', path: '/product/matrix' } : { name: 'Solutions', path: '/solutions' };
const siblings = (isProduct ? PRODUCTS : SOLUTIONS).filter((p) => p.slug !== page.slug);
// Two pictures of the street the desks work on, different on each page.
const STREET: [ImageName, string][] = [
  ['bse-building', 'The Bombay Stock Exchange on Dalal Street'],
  ['dalal-street-sign', 'The Dalal Street road sign, PIN 400001'],
  ['bse-tower-2006', 'Phiroze Jeejeebhoy Towers, home of the BSE'],
  ['bombay-fort-1936', 'The Fort district of Bombay, 1936'],
  ['bombay-1758-map', 'French plan of Bombay Fort, 1758'],
];
const k = page.slug.length % STREET.length;
const pics = [STREET[k], STREET[(k + 2) % STREET.length]];
const lead = STREET[(k + 1) % STREET.length];
---
<Base
  title={page.seoTitle}
  description={page.description}
  schema={[
    breadcrumbs([{ name: 'AlphaBoard', path: '/' }, crumb, { name: page.name, path }]),
    ...(page.faq.length ? [faqPage(page.faq)] : []),
    ...(isProduct ? [softwareApplication()] : []),
  ]}
>
  <section class="top" data-section="masthead" aria-labelledby="page-title">
    <div class="copy" data-reveal>
      <nav class="crumbs" aria-label="Breadcrumb"><a href={crumb.path}>{crumb.name}</a> / <span aria-current="page">{page.name}</span></nav>
      <h1 id="page-title">{page.title}</h1>
      <p class="lede">{page.lede}</p>
      <div class="ctas">
        <a class="btn" href="/demo" data-track-cta={`${section}-${page.slug}-hero`}>Book a demo <span class="arrow" aria-hidden="true">→</span></a>
        {siblings[0] && <a class="btn btn--line" href={`/${section}/${siblings[0].slug}`}>{isProduct ? siblings[0].name : `For ${siblings[0].name}`}</a>}
      </div>
    </div>
    <figure class="gem"><Photo name={lead[0]} alt={lead[1]} eager sizes="(max-width: 960px) 100vw, 45vw" /></figure>
  </section>

  <section class="pains wrap" data-section="pains" aria-labelledby="pains-title">
    <h2 id="pains-title" data-reveal><span>{page.painsTitle}</span></h2>
    <ul>
      {page.pains.map((p) => (
        <li data-reveal><h3>{p.title}</h3><p>{p.body}</p></li>
      ))}
    </ul>
  </section>

  <section class="proc wrap" data-section="process" aria-labelledby="proc-title">
    <h2 id="proc-title" data-reveal><span>{page.processTitle}</span></h2>
    <ol class="flow" data-reveal>
      {page.process.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}
    </ol>
  </section>

  <section class="feat wrap" data-section="features" aria-labelledby="feat-title">
    <div class="frag">
      <div class="panel ui-card"><Visual kind={page.visual} /></div>
    </div>
    <div class="pts">
      <h2 id="feat-title" data-reveal><span>{page.pointsTitle}</span></h2>
      {page.points.map((p) => (
        <div class="pt" data-reveal><h3>{p.title}</h3><p>{p.body}</p></div>
      ))}
    </div>
  </section>

  <section class="proof wrap" data-section="proof" aria-labelledby="proof-title">
    <div class="say">
      <h2 id="proof-title" data-reveal><span>{page.proofTitle}</span></h2>
      <p data-reveal>{page.proof}</p>
    </div>
    <div class="pics">
      {pics.map(([name, alt]) => <Photo name={name} alt={alt} sizes="(max-width: 960px) 45vw, 22vw" />)}
    </div>
  </section>

  {page.faq.length > 0 && <Faq items={page.faq} title="Asked by investment teams" />}

  <nav class="next wrap" aria-label={isProduct ? 'Other product' : 'Other teams'}>
    <p>{isProduct ? 'The other half of AlphaBoard' : 'AlphaBoard for other teams'}</p>
    <ul>{siblings.map((s) => <li><a href={`/${section}/${s.slug}`}>{s.name} <span aria-hidden="true">→</span></a></li>)}</ul>
  </nav>

  <Close title="On the record." text={page.close} />
</Base>

<style>
  .top {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); align-items: center;
    min-height: min(100svh, 980px); padding: 96px var(--margin) 40px;
  }
  .copy { grid-column: 1 / 7; display: grid; gap: 24px; justify-items: start; }
  .crumbs { font-size: 15px; color: var(--ink-soft); }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs span { color: var(--ink); }
  h1 { font-size: clamp(40px, 4.6vw, 76px); line-height: 1; max-width: 12em; }
  .lede { font-size: var(--s-2); line-height: 1.55; max-width: 44ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .gem { grid-column: 7 / 13; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }

  section h2 { font-size: var(--s-4); max-width: 14em; }
  .pains { padding-top: var(--section); }
  .pains ul { margin-top: 56px; display: grid; gap: 48px; }
  .pains li { display: grid; grid-template-columns: 5fr 7fr; gap: var(--gap); align-items: baseline; }
  .pains h3 { font-size: var(--s-3); line-height: 1.15; }
  .pains p { font-size: var(--s-2); max-width: 46ch; }

  .proc { padding-top: var(--section); }
  .flow { margin-top: 48px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .flow li { padding: 24px; display: grid; gap: 10px; align-content: start; background: var(--ground-2); }
  .flow li:nth-child(even) { background: var(--ground-3); }
  .flow h3 { font-size: 24px; }
  .flow p { font-size: 16px; }

  .feat { padding-top: var(--section); display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); align-items: start; }
  .frag { grid-column: 1 / 7; position: sticky; top: 96px; }
  .panel { padding: 10px; min-height: 340px; display: grid; }
  .pts { grid-column: 8 / 13; display: grid; gap: 40px; }
  .pt h3 { font-size: var(--s-3); margin-bottom: 8px; }
  .pt p { font-size: 17px; max-width: 44ch; }

  .proof { padding-top: var(--section); display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); align-items: center; }
  .proof .say { grid-column: 1 / 7; display: grid; gap: 24px; }
  .proof .pics { grid-column: 8 / 13; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .proof .pics :global(.photo) { aspect-ratio: 4 / 5; }
  .proof h2 { font-size: var(--s-3); color: var(--accent); }
  .proof p { font-size: clamp(22px, 2vw, 30px); line-height: 1.35; letter-spacing: -0.015em; max-width: 34em; }

  .next { padding-top: var(--section); display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 40px; }
  .next p { font-size: 16px; color: var(--ink-soft); }
  .next ul { display: flex; flex-wrap: wrap; gap: 12px 32px; }
  .next a { text-decoration: none; font-size: var(--s-3); }
  .next a span { display: inline-block; transition: transform 200ms var(--ease); }
  .next a:hover { color: var(--accent); }
  .next a:hover span { transform: translateX(4px); }

  @media (max-width: 960px) {
    .top { grid-template-columns: 1fr; padding-top: 80px; min-height: 0; }
    .copy, .gem { grid-column: 1; }
    .gem { grid-row: 1; }
    .pains li { grid-template-columns: 1fr; gap: 8px; }
    .flow { grid-template-columns: 1fr 1fr; }
    .feat { grid-template-columns: 1fr; }
    .frag, .pts { grid-column: 1; }
    .frag { position: static; }
    .proof .say, .proof .pics { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) { .flow { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { section h2 { font-size: 30px; } }
</style>
