---
import PageTemplate from '../../components/sections/PageTemplate.astro';
import { SOLUTIONS, type LandingPage } from '../../data/pages';

export function getStaticPaths() {
  return SOLUTIONS.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: LandingPage };
---
<PageTemplate page={page} section="solutions" />
