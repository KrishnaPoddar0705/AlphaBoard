---
/** Solutions index: one row per kind of team, each with its own process in four words. */
import Base from '../../layouts/Base.astro';
import Close from '../../components/home/Close.astro';
import { SOLUTIONS } from '../../data/pages';
import { breadcrumbs } from '../../lib/schema';
import Photo from '../../components/ui/Photo.astro';
import type { ImageName } from '../../lib/images';

// Pictures of the street the desks trade on, one per row.
const PICS: Record<string, [ImageName, string]> = {
  pms: ['bse-building', 'The Bombay Stock Exchange on Dalal Street'],
  aif: ['bse-tower-2006', 'Phiroze Jeejeebhoy Towers, home of the BSE'],
  'family-offices': ['bombay-fort-1936', 'The Fort district of Bombay, 1936'],
  'venture-capital': ['dalal-street-sign', 'The Dalal Street road sign, PIN 400001'],
};
---
<Base
  title="Solutions: AlphaBoard for PMS, AIF, family office and venture capital teams"
  description="AlphaBoard fits the way each investment team works: PMS research desks, Category II and III AIFs, family offices and venture capital firms. One record per company, a Institutional Memory over all your research, and one view for the people allocating capital."
  schema={[breadcrumbs([{ name: 'AlphaBoard', path: '/' }, { name: 'Solutions', path: '/solutions' }])]}
>
  <section class="top" data-section="masthead" aria-labelledby="sol-title">
    <div class="copy" data-reveal>
      <h1 id="sol-title">Built around how your desk works</h1>
      <p class="lede">A PMS lives by results season, an AIF by its investment committee, a family office by the principal’s questions and a venture firm by its pipeline. AlphaBoard keeps each of them on one research record.</p>
    </div>
    <figure class="gem"><Photo name="bse-building" alt="The Bombay Stock Exchange on Dalal Street" eager sizes="(max-width: 960px) 100vw, 45vw" /></figure>
  </section>

  <section class="list wrap" data-section="solutions" aria-labelledby="list-title">
    <h2 id="list-title" class="sr-only">Teams AlphaBoard is built for</h2>
    <ul>
      {SOLUTIONS.map((s) => (
        <li data-reveal>
          <a href={`/solutions/${s.slug}`} data-track-cta={`solutions-${s.slug}`}>
            <span class="ph"><Photo name={PICS[s.slug][0]} alt={PICS[s.slug][1]} sizes="(max-width: 960px) 40vw, 160px" /></span>
            <span class="name type-wide">{s.name}</span>
            <span class="say">{s.lede}</span>
            <span class="steps">{s.process.map((p) => <span>{p.title}</span>)}</span>
            <span class="go">See how it fits <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Close title="On the record." text="Tell us how your team works and we will load your own coverage before the call." />
</Base>

<style>
  .top {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); align-items: center;
    min-height: min(92svh, 900px); padding: 96px var(--margin) 40px;
  }
  .copy { grid-column: 1 / 7; display: grid; gap: 24px; }
  h1 { font-size: clamp(40px, 4.6vw, 76px); line-height: 1; max-width: 11em; }
  .lede { font-size: var(--s-2); line-height: 1.55; max-width: 44ch; }
  .gem { grid-column: 7 / 13; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }

  .list { padding-top: 40px; }
  .list ul { display: grid; gap: 12px; }
  .list a {
    display: grid; grid-template-columns: 160px 4fr 6fr 2fr; gap: 8px var(--gap); align-items: start;
    padding: 40px 32px; border-radius: var(--radius); text-decoration: none;
    background: var(--ground-2); transition: background-color 300ms var(--ease), transform 300ms var(--ease-out);
  }
  .list a:hover { background: var(--ground-3); transform: translateY(-2px); }
  .name { font-size: clamp(26px, 2.6vw, 42px); }
  .say { font-size: 17px; max-width: 52ch; }
  .ph { grid-row: span 2; }
  .ph :global(.photo) { aspect-ratio: 1; border-radius: 14px; }
  .steps { grid-column: 3; display: flex; flex-wrap: wrap; gap: 8px; }
  .steps span { padding: 6px 12px; font-size: 14px; background: var(--ground-2); }
  .go { grid-column: 4; grid-row: 1; justify-self: end; color: var(--accent); font-size: 16px; white-space: nowrap; }
  @media (max-width: 960px) {
    .top { grid-template-columns: 1fr; min-height: 0; padding-top: 80px; }
    .copy, .gem { grid-column: 1; }
    .gem { grid-row: 1; }
    .list a { grid-template-columns: 1fr; padding: 28px 20px; }
    .steps, .go, .ph { grid-column: 1; grid-row: auto; justify-self: start; }
    .ph { width: 120px; }
  }
</style>
